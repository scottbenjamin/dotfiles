# Copy to $(herdr plugin config-dir absci.gitlab-review)/.env and edit.
# All values are optional; defaults shown.

# GitLab host glab is authenticated against.
HERDR_GL_HOST=gitlab.com

# Reviewer username. Leave unset to auto-detect from `glab api /user`.
#HERDR_GL_USER=sbenjamin4

# Where existing local clones live (searched first, so review reuses your checkout).
HERDR_GL_REPOS_DIR=$HOME/code

# Fallback clone dir when the repo isn't found under HERDR_GL_REPOS_DIR.
#HERDR_GL_CACHE_DIR=$HOME/.local/state/herdr/gitlab-review/repos

# Pane-1 diff viewer for the MR's changed files:
#   delta   - side-by-side, syntax-highlighted, n/N jumps files (default)
#   less    - plain `glab mr diff`
#   lazygit - interactive TUI (shows full branch history, not just MR files)
HERDR_GL_DIFF_VIEWER=delta

# Coding agent that reviews the MR: claude | pi | cursor (or any binary on PATH
# that takes a trailing prompt + optional --model, e.g. codex, gemini).
HERDR_GL_REVIEW_AGENT=claude

# Model passed via --model. Leave unset for the per-agent default
# (claude -> sonnet; cursor -> composer; pi -> its own default). "" forces default.
#   claude: sonnet, opus, ...
#   cursor: composer, composer-2.5, composer-2.5-fast, gpt-5, sonnet-4-thinking
#   pi:     provider/id patterns
#HERDR_GL_REVIEW_MODEL=sonnet

# Reuse the picker's MR list for this many seconds (reopening is instant).
HERDR_GL_CACHE_TTL=60

# Max MRs fetched per query.
HERDR_GL_PER_PAGE=50
